          amount: 5
      failure:
        narrative: "독성 포자가 퍼졌다! 체력 18을 잃고 약초도 찾지 못했다."
        healthChange: -18
        maxHealthChange: 0
        stats: []
        rewards: []
    - label: "향을 피해 가장자리만 살핀다"
      description: ""
      useStatCheck: 0
      checkStat: 0
      minimumStat: 5
      success:
        narrative: "위험을 피하며 약초 2개를 얻었다."
        healthChange: 0
